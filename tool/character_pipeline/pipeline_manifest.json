{
  "version": 4,
  "canvas": {
    "width": 1024,
    "height": 1792,
    "format": "PNG",
    "color_mode": "RGBA",
    "transparent": true,
    "frame_rate": 24
  },
  "stages": [1, 5, 10, 15, 20, 30, 40, 50, 60, 70, 80, 90, 100],
  "identities": {
    "male": {
      "front_master": "assets/characters/male/level_01.png",
      "back_master": "assets/characters/male/level_01_back.png"
    },
    "female": {
      "front_master": "assets/characters/female/level_01.png",
      "back_master": "assets/characters/female/level_01_back.png"
    },
    "non_binary": {
      "front_master": "assets/characters/non_binary/level_01.png",
      "back_master": "assets/characters/non_binary/level_01_back.png"
    }
  },
  "motions": {
    "idle_breath": {"frames": 96, "loop": true},
    "blink": {"frames": 12, "loop": false},
    "tail_idle": {"frames": 96, "loop": true},
    "double_biceps": {"frames": 48, "loop": false},
    "chest_flex": {"frames": 48, "loop": false},
    "leg_pose": {"frames": 48, "loop": false},
    "triceps": {"frames": 48, "loop": false},
    "victory": {"frames": 72, "loop": false},
    "pb_celebration": {"frames": 72, "loop": false},
    "recovery": {"frames": 96, "loop": true}
  },
  "anatomy_contract": {
    "tail_anchor": {
      "bone": "tail_root",
      "parent": "pelvis",
      "head": [0.0, 0.12, 3.35],
      "tail": [0.0, 0.42, 3.12],
      "rear_midline": true,
      "concealed_by_rear_waistband": true,
      "forbid_between_thigh_origin": true,
      "preserve_across_views_and_motions": true
    }
  },
  "emote_contract": {
    "types": ["double_biceps", "chest_flex", "leg_pose", "triceps"],
    "selection": "random_without_immediate_repeat",
    "views": ["front", "back"],
    "require_every_identity": true,
    "require_every_stage": true,
    "require_every_appearance": true,
    "synthetic_body_transform": false,
    "pose_specs": {
      "double_biceps": {
        "entry": "both arms extend straight outward to shoulder height",
        "hold_front": "elbows bend inward, upper arms remain at shoulder height, one leg steps forward and outward",
        "hold_back": "elbows bend as in front pose, one foot steps back onto the toes",
        "hands_male_non_binary": "fists clenched and turned down",
        "hands_female": "open hands in the Women's Physique convention"
      },
      "chest_flex": {
        "canonical_pose": "side chest",
        "hold": "near arm bends to a right angle, far hand grips the wrist, near leg bends and rests on toes, chest expands"
      },
      "leg_pose": {
        "canonical_pose": "abdominals and thighs",
        "hold": "both hands behind head, one leg forward, torso crunches slightly while abdominals and front thigh contract"
      },
      "triceps": {
        "canonical_pose": "side triceps",
        "hold": "both arms behind the back, rear hand grips front wrist, near foot flat, far foot on toes, chest raised"
      }
    }
  },
  "release_contract": {
    "views": ["front", "back"],
    "require_every_identity": true,
    "require_every_motion": true,
    "activate_partial_stage": false,
    "runtime_physique_scaling": false
  }
}
